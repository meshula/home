## Custom prompt: horizontal rule + pwd + ">" symbol

_draw_rule() {
  printf '%0.s─' {1..40}
}

_draw_prompt() {
  local _old_status=$?
  local rule=$(_draw_rule)
  local color
  if (( _old_status == 0 )); then
    color="green"
  else
    color="red"
  fi
  PROMPT="%F{${color}}${rule}%f
%F{blue}%~%f
> "
}

_draw_prompt

precmd() {
  _draw_prompt
}
